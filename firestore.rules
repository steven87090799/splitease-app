rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // For this MVP, allow anyone to read and write to any group.
    // This makes link sharing easy to implement.
    // In a production app, you would want to add authentication
    // and rules to restrict access to only group members.
    match /groups/{groupId} {
      allow read, write: if true;
    }
  }
}
